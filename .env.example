# Postgres (docker compose up -d starts one on port 5433)
DATABASE_URL="postgresql://support:support@localhost:5433/support_expert"

# Any OpenAI-compatible endpoint serving an open-weight model.
# Together:   https://api.together.xyz/v1         meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
# Fireworks:  https://api.fireworks.ai/inference/v1  accounts/fireworks/models/llama-v3p1-8b-instruct
# OpenRouter: https://openrouter.ai/api/v1         meta-llama/llama-3.1-8b-instruct
# vLLM:       http://localhost:8000/v1             <your served model name>
LLM_BASE_URL="https://api.together.xyz/v1"
LLM_MODEL="meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo"
# Leave empty to run with the offline extractive stub (clearly labelled in the UI).
LLM_API_KEY=""

# Name shown on review records until auth exists.
DEFAULT_REVIEWER="Support Expert"
